# NoevaPet temporary Coming Soon overlay — 2026-10-09
# Non-destructive: all previous files remain intact for rollback.
Options -Indexes
RewriteEngine On

# Keep the canonical hostname / HTTPS redirect.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.noevapet\.de$ [NC]
RewriteRule ^ https://noevapet.de%{REQUEST_URI} [R=301,L]

# Publicly accessible legal pages, verification, status and assets used by the overlay.
RewriteCond %{REQUEST_URI} !^/coming-soon\.html$ [NC]
RewriteCond %{REQUEST_URI} !^/robots\.txt$ [NC]
RewriteCond %{REQUEST_URI} !^/release\.json$ [NC]
RewriteCond %{REQUEST_URI} !^/imprint\.html$ [NC]
RewriteCond %{REQUEST_URI} !^/privacy\.html$ [NC]
RewriteCond %{REQUEST_URI} !^/assets/noevapet-logo-v13\.png$ [NC]
RewriteCond %{REQUEST_URI} !^/assets/hero-pets\.png$ [NC]
RewriteCond %{REQUEST_URI} !^/assets/icon-32\.png$ [NC]
RewriteCond %{REQUEST_URI} !^/assets/styles\.css$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/ [NC]
RewriteRule ^ /coming-soon.html [L]

# Prevent search engines from indexing the temporary landing page and old URLs.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set Cache-Control "no-store, max-age=0"
</IfModule>
